# Copy to .env for running the engine outside Docker. In Docker these come
# from deploy/.env instead; see deploy/docker-compose.engine.yml.

SCREENING_ENVIRONMENT=development

SCREENING_DATABASE_URL=postgresql+psycopg://screening:screening@localhost:5433/screening
SCREENING_REDIS_URL=redis://localhost:6379/0

# Shared with Frappe. Both sides sign with it, so it is the only thing
# standing between the internal network and a writable hiring score.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SCREENING_CALLBACK_SECRET=replace-me-with-at-least-32-characters

SCREENING_QUARANTINE_ROOT=./var/quarantine

# Local vLLM. Not needed until the pipeline is wired.
SCREENING_VLM_ENDPOINT=http://localhost:8001/parse
SCREENING_VLM_TIMEOUT_SECONDS=180

SCREENING_MAX_UPLOAD_BYTES=20971520
SCREENING_MAX_RESUME_PAGES=15

SCREENING_FRAPPE_BASE_URL=http://frappe-internal:8000
