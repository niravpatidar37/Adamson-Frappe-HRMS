# Copy to deploy/.env. Docker Compose reads it automatically.

# Shared with Frappe; both sides sign requests with it. At least 32 chars.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SCREENING_CALLBACK_SECRET=

# Used for the engine's own Postgres, which is not the Frappe database.
POSTGRES_PASSWORD=screening
